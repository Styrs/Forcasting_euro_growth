  avg_rolling_forecasts <- forecasts_recent %>%
    group_by(Date) %>%
    summarise(
      Avg_Growth = mean(Eurozone_Growth, na.rm = TRUE),
      Min_Growth = min(Eurozone_Growth, na.rm = TRUE),
      Max_Growth = max(Eurozone_Growth, na.rm = TRUE),
      .groups = "drop"
    )
  
  p2 <- ggplot() +
    # Données historiques
    geom_line(data = historical_recent,
