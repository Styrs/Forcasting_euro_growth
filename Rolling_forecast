    theme_minimal(base_size = 12) +
    theme(legend.position = "bottom")
  
  print(p2)
  
  # 5.4 Sauvegarder les graphiques
  ggsave("rolling_forecasts_all_windows.png", p1, width = 12, height = 6, dpi = 300)
  ggsave("rolling_forecasts_average.png", p2, width = 12, height = 6, dpi = 300)
  
  print("=== VISUALISATIONS TERMINÉES ===")
  print(paste("Nombre total de fenêtres rolling:", length(unique(all_rolling_forecasts_plot$Window))))
  print(paste("Période couverte historique:", min(historical_recent$Date), "à", max(historical_recent$Date)))
  print(paste("Période couverte forecasts:", min(forecasts_recent$Date), "à", max(forecasts_recent$Date)))
}


