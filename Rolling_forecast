# ----------------------------------------------------------------------------
# CHAPTER 1 – Compute forecast growth WITH ROLLING WINDOW
# ----------------------------------------------------------------------------

# List of countries to process
countries <- c("France", "Germany", "Italy", "Netherlands", "Spain", "Sum Small euro countries")

# Parameters - fenêtre glissante de taille fixe
window_size <- 10 * 4  # 10 ans en trimestres = 40 trimestres
debut_total <- 2000.25
fin_total <- 2025.25

# Calcul du nombre de boucles possibles
first_window_end <- debut_total + (window_size - 1) * 0.25
total_periods <- (fin_total - debut_total) * 4
nb_boucles <- total_periods - window_size + 1

print(paste("Nombre de boucles rolling:", nb_boucles))

# To store results for each rolling window
all_rolling_results <- list()

for (i in 1:nb_boucles) {
  
  # Calcul de la fenêtre glissante
  start_quarter <- debut_total + (i-1) * 0.25  # Décale d'un trimestre à chaque boucle
  end_quarter <- start_quarter + (window_size - 1) * 0.25  # Taille fixe
  
  print(paste("=== ROLLING WINDOW", i, "==="))
  print(paste("Fenêtre:", start_quarter, "à", end_quarter))
  
  # Store results for this specific window
  window_country_results <- list()
  
  for (country_name in countries) {
    
    print(paste("Pays:", country_name))
    
    # MÊME PROCESSUS que le code extended
    country_data <- prepare_country_ts(data_countries_euro_growth_gdp_seas,
                                       country_name, start_quarter, end_quarter)
    arma_fit <- select_best_arma(country_data$ts_data)
    
    # Generate forecasts (même fonction)
    fc_growth <- forecast_arma_model(
      model         = arma_fit$model,
      start_quarter = start_quarter,
      end_quarter   = end_quarter,
      horizons      = 1:10
    )
    
    # Même structure de stockage
    window_country_results[[country_name]] <- list(
      arma_fit      = arma_fit,
      forecast      = fc_growth,
      train_data    = country_data$train_data
    )
  }
  
  # Stocker les résultats de cette fenêtre
  all_rolling_results[[paste0("Window_", i)]] <- list(
    window_number = i,
    window_range = c(start_quarter, end_quarter),
    country_results = window_country_results
  )
}

# ----------------------------------------------------------------------------
# CHAPTER 2 – Tableaux des prévisions de croissance (rolling version)
# ----------------------------------------------------------------------------

# Pour stocker tous les tableaux de chaque fenêtre
all_rolling_forecast_tables <- list()

for (window_name in names(all_rolling_results)) {
  
  window_data <- all_rolling_results[[window_name]]
  window_num <- window_data$window_number
  window_range <- window_data$window_range
  
  # Créer le tableau pour cette fenêtre (même structure que extended)
  forecast_table_growth <- bind_rows(
    lapply(names(window_data$country_results), function(country_name) {
      
      res <- window_data$country_results[[country_name]]
      
      tibble(
        Window = window_num,
        Country = country_name,
        Horizon = 1:10,
        Forecast_Date = res$forecast$forecast_dates,
        Forecast_Value = res$forecast$forecast_values,
        AR_Order = res$arma_fit$order["p"],
        MA_Order = res$arma_fit$order["q"],
        Window_Start = window_range[1],
        Window_End = window_range[2]
      )
    })
  )
  
  # Ajouter colonne Modèle
  forecast_table_growth <- forecast_table_growth %>%
    mutate(Model = paste0("ARMA(", AR_Order, ",", MA_Order, ")"))
  
  # Format wide pour cette fenêtre
  forecast_table_growth_wide <- forecast_table_growth %>%
    select(Window, Country, Model, Forecast_Date, Forecast_Value) %>%
    pivot_wider(
      id_cols = c(Window, Country, Model),
      names_from = Forecast_Date,
      values_from = Forecast_Value
    ) %>%
    arrange(Window, Country)
  
  # Stocker
  all_rolling_forecast_tables[[window_name]] <- list(
    long_format = forecast_table_growth,
    wide_format = forecast_table_growth_wide
  )
}

# Combiner tous les tableaux wide en un seul grand tableau
combined_rolling_growth_forecasts <- bind_rows(
  lapply(all_rolling_forecast_tables, function(x) x$wide_format)
)

# Afficher un aperçu
print("=== APERÇU DES PRÉVISIONS ROLLING (croissance) ===")
print(head(combined_rolling_growth_forecasts))

# Sauvegarder
write.csv(combined_rolling_growth_forecasts, "rolling_growth_forecasts.csv", row.names = FALSE)





# ----------------------------------------------------------------------------
# CHAPTER 3 – Compute forecasted Nominal GDP (rolling version)
# ----------------------------------------------------------------------------

# Pour stocker tous les tableaux de PIB nominal pour chaque fenêtre
all_rolling_nominal_tables <- list()

for (window_name in names(all_rolling_results)) {
  
  window_data <- all_rolling_results[[window_name]]
  window_num <- window_data$window_number
  
  # Créer le tableau de PIB nominal pour cette fenêtre
  forecast_table_nominal <- bind_rows(
    lapply(names(window_data$country_results), function(country_name) {
      
      res <- window_data$country_results[[country_name]]
      
      # Dernier PIB nominal observé dans la fenêtre d'entraînement
      train_df <- res$train_data %>%
        filter(!is.na(Nominal_GDP)) %>%
        arrange(Quarter)
      
      last_nominal_gdp <- tail(train_df$Nominal_GDP, 1)
      
      # Prévisions de croissance pour cette fenêtre
      g <- res$forecast$forecast_values   # en %
      dates <- res$forecast$forecast_dates
      model <- paste0("ARMA(", res$arma_fit$order["p"], ",", res$arma_fit$order["q"], ")")
      
      # Appliquer croissance récursivement : GDP_{t+1} = GDP_t * (1 + g/100)
      nominal_fc <- numeric(length(g))
      prev <- last_nominal_gdp
      
      for (i in seq_along(g)) {
        prev <- prev * (1 + g[i] / 100)
        nominal_fc[i] <- prev
      }
      
      tibble(
        Window = window_num,
        Country = country_name,
        Model = model,
        Forecast_Date = dates,
        Forecast_Nominal_GDP = nominal_fc
      )
    })
  )
  
  # Format wide pour cette fenêtre
  forecast_table_nominal_wide <- forecast_table_nominal %>%
    pivot_wider(
      id_cols = c(Window, Country, Model),
      names_from = Forecast_Date,
      values_from = Forecast_Nominal_GDP
    ) %>%
    arrange(Window, Country)
  
  # Stocker
  all_rolling_nominal_tables[[window_name]] <- list(
    long_format = forecast_table_nominal,
    wide_format = forecast_table_nominal_wide
  )
}

# Combiner tous les tableaux wide en un seul
combined_rolling_nominal_forecasts <- bind_rows(
  lapply(all_rolling_nominal_tables, function(x) x$wide_format)
)

# Afficher un aperçu
print("=== APERÇU DES PRÉVISIONS ROLLING (PIB nominal) ===")
print(head(combined_rolling_nominal_forecasts))

# Sauvegarder
write.csv(combined_rolling_nominal_forecasts, "rolling_nominal_forecasts.csv", row.names = FALSE)




# ----------------------------------------------------------------------------
# CHAPTER 4 – Compute forecasted Nominal and Growth for Eurozone (rolling version)
# ----------------------------------------------------------------------------

# Pour stocker tous les résultats zone euro pour chaque fenêtre
all_rolling_eurozone_results <- list()

for (window_name in names(all_rolling_results)) {
  
  window_data <- all_rolling_results[[window_name]]
  window_num <- window_data$window_number
  window_end <- window_data$window_range[2]
  
  # 4.1 Récupérer les prévisions nominales long format pour cette fenêtre
  nominal_long <- all_rolling_nominal_tables[[window_name]]$long_format
  
  # 4.2 Agréger par date pour obtenir le PIB nominal zone euro
  eurozone_nominal <- nominal_long %>%
    group_by(Forecast_Date) %>%
    summarise(
      Eurozone_Nominal_GDP = sum(Forecast_Nominal_GDP, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    arrange(Forecast_Date)
  
  # 4.3 Calculer la croissance zone euro entre périodes
  # Dernier PIB nominal observé de la zone euro (fin de fenêtre d'entraînement)
  last_euro_nominal <- Eurozone_GDPgrowth_seas %>%
    filter(Quarter <= window_end) %>%
    filter(!is.na(Eurozone_Nominal_GDP)) %>%
    arrange(desc(Quarter)) %>%
    slice(1) %>%
    pull(Eurozone_Nominal_GDP)
  
  eurozone_nominal <- eurozone_nominal %>%
    arrange(Forecast_Date) %>%
    mutate(
      lag_nominal = dplyr::lag(Eurozone_Nominal_GDP),
      lag_nominal = if_else(
        is.na(lag_nominal),
        last_euro_nominal,  # Utiliser le dernier observé comme point de départ
        lag_nominal
      ),
      Eurozone_Growth = 100 * (Eurozone_Nominal_GDP / lag_nominal - 1)
    ) %>%
    select(-lag_nominal)
  
  # 4.4 Format wide pour croissance zone euro
  eurozone_growth_wide <- eurozone_nominal %>%
    mutate(Window = window_num) %>%
    select(Window, Forecast_Date, Eurozone_Growth) %>%
    pivot_wider(
      id_cols = Window,
      names_from = Forecast_Date,
      values_from = Eurozone_Growth
    )
  
  # 4.5 Format wide pour PIB nominal zone euro
  eurozone_nominal_wide <- eurozone_nominal %>%
    mutate(Window = window_num) %>%
    select(Window, Forecast_Date, Eurozone_Nominal_GDP) %>%
    pivot_wider(
      id_cols = Window,
      names_from = Forecast_Date,
      values_from = Eurozone_Nominal_GDP
    )
  
  # Stocker les résultats pour cette fenêtre
  all_rolling_eurozone_results[[window_name]] <- list(
    nominal_long = eurozone_nominal,
    growth_wide = eurozone_growth_wide,
    nominal_wide = eurozone_nominal_wide
  )
}

# Combiner tous les résultats zone euro
combined_rolling_eurozone_growth <- bind_rows(
  lapply(all_rolling_eurozone_results, function(x) x$growth_wide)
)

combined_rolling_eurozone_nominal <- bind_rows(
  lapply(all_rolling_eurozone_results, function(x) x$nominal_wide)
)

# Afficher les résultats
print("=== PRÉVISIONS ROLLING ZONE EURO (croissance) ===")
print(combined_rolling_eurozone_growth)

print("=== PRÉVISIONS ROLLING ZONE EURO (PIB nominal) ===")
print(combined_rolling_eurozone_nominal)

# Sauvegarder
write.csv(combined_rolling_eurozone_growth, "rolling_eurozone_growth_forecasts.csv", row.names = FALSE)
write.csv(combined_rolling_eurozone_nominal, "rolling_eurozone_nominal_forecasts.csv", row.names = FALSE)


# ----------------------------------------------------------------------------
# CHAPTER 5 – Visualisations pour le rolling window (CORRIGÉ)
# ----------------------------------------------------------------------------

# 5.1 Préparer les données historiques et de prévisions
historical_growth <- Eurozone_GDPgrowth_seas %>%
  select(Quarter, seasonal_adjusted_wins) %>%
  mutate(Date = as.yearqtr(Quarter),
         Type = "Historical GDP Growth")

# Préparer toutes les prévisions rolling pour le graphique
all_rolling_forecasts_plot <- bind_rows(
  lapply(names(all_rolling_eurozone_results), function(window_name) {
    window_data <- all_rolling_eurozone_results[[window_name]]
    window_num <- as.numeric(str_replace(window_name, "Window_", ""))
    
    window_data$nominal_long %>%
      mutate(Window = window_num,
             Date = as.yearqtr(Forecast_Date),
             Type = paste0("Forecast Window ", window_num))
  })
) %>%
  filter(!is.na(Eurozone_Growth))  # ← FILTRER LES VALEURS MANQUANTES

# Vérifier ce que nous avons
print("=== DONNÉES DISPONIBLES ===")
print(paste("Fenêtres rolling:", length(unique(all_rolling_forecasts_plot$Window))))
print(paste("Périodes de forecast:", length(unique(all_rolling_forecasts_plot$Date))))
print(head(all_rolling_forecasts_plot))

# Garder seulement les données récentes (à partir de 2015)
