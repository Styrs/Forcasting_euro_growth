  filter(Date >= as.yearqtr("2015 Q1"))

forecasts_recent <- all_rolling_forecasts_plot %>% 
  filter(Date >= as.yearqtr("2015 Q1"))

# Vérifier si nous avons des données de forecast
if (nrow(forecasts_recent) == 0) {
  print("ATTENTION: Aucune donnée de forecast après 2015")
  print("Vérification des données brutes:")
  print(head(all_rolling_forecasts_plot))
} else {
  print(paste("Données forecasts récentes:", nrow(forecasts_recent), "lignes"))
  
  # 5.2 Graphique principal - Toutes les prévisions rolling
  p1 <- ggplot() +
