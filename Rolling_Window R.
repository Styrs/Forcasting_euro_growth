csv_roll <- file.path(base_dir, "output", paste0("RollingForecast_YbyY_2011_2027_", stamp, ".csv"))
readr::write_csv(rolling_2011_2027, csv_roll)
cat("✅ Rolling annuel (fenêtre fixe 10 ans) exporté : ", csv_roll, "\n", sep = "")
