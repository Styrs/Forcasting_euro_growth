## 2) Long format + typage
data_countries_euro_prepared <- data_countries_euro %>%
  rename(Country = TIME) %>%
  pivot_longer(
    cols = -Country,
    names_to = "Quarter",
    values_to = "Nominal_GDP"
  ) %>%
  mutate(
    Quarter = as.yearqtr(Quarter, format = "%Y-Q%q"),
    Nominal_GDP = as.numeric(Nominal_GDP)
  )

## 3) Compléter le calendrier trimestriel par pays
##    (remplit les trimestres manquants entre min et max)
data_countries_euro_prepared <- data_countries_euro_prepared %>%
  group_by(Country) %>%
  arrange(Quarter, .by_group = TRUE) %>%
  tidyr::complete(
    Quarter = seq(min(Quarter, na.rm = TRUE), max(Quarter, na.rm = TRUE), by = 1/4)
  ) %>%
  ungroup()

## 4) Imputation des NA de Nominal_GDP
##    - interpolation linéaire (na.approx)
##    - extrapolation aux bords (rule = 2) si besoin
##    - si une série est ENTIEREMENT NA, on la laisse NA (sera filtrée plus tard)
data_countries_euro_prepared <- data_countries_euro_prepared %>%
  group_by(Country) %>%
  arrange(Quarter, .by_group = TRUE) %>%
  mutate(
    Nominal_GDP = {
      x <- Nominal_GDP
      if (all(is.na(x))) x else zoo::na.approx(x, na.rm = FALSE, rule = 2)
    }
  ) %>%
  ungroup()

## 5) Calcul de la croissance q/q (%) et nettoyage final des NA
