# AICc sûr
safe_AICc <- function(fit, n){
  out <- tryCatch(forecast::AICc(fit), error = function(e) NA_real_)
  if (is.finite(out)) return(out)
  k <- tryCatch(length(fit$coef), error = function(e) NA_integer_)
  a <- tryCatch(AIC(fit),        error = function(e) NA_real_)
  if (!is.finite(k) || !is.finite(a) || (n - k - 1) <= 0) return(Inf)
  a + 2*k*(k+1)/(n - k - 1)
}

# Grille autour de (p0,q0)
grid_pq <- function(p0, q0, around = 1, pmax = 3, qmax = 3){
  pset <- sort(unique(pmax(0, pmin(pmax, c(p0-around, p0, p0+around)))))
  qset <- sort(unique(pmax(0, pmin(qmax, c(q0-around, q0, q0+around)))))
  tidyr::expand_grid(p = pset, q = qset) |> dplyr::filter(!(p==0 & q==0))
}

# Sélection ARMA par AICc + Ljung-Box
select_arma <- function(x, p0, q0, around = 1){
  x <- stats::na.omit(as.numeric(x))
  if (length(x) < 12 || length(unique(x)) < 3) {
    return(list(best = tibble(p=NA, q=NA, AICc=Inf, lb_p=NA_real_), table = tibble(), note = "short/constant"))
  }
  tsx  <- ts(x, frequency = 4)
  n    <- length(tsx)
  grid <- grid_pq(p0, q0, around)
  res <- purrr::pmap_dfr(grid, function(p, q){
    fit <- tryCatch(Arima(tsx, order = c(p,0,q), include.mean = TRUE), error = function(e) NULL)
    if (is.null(fit)) return(tibble(p=p, q=q, AICc=Inf, lb_p=NA_real_))
    tibble(
      p = p, q = q,
      AICc = safe_AICc(fit, n),
      lb_p = tryCatch(Box.test(residuals(fit), lag = 8, type = "Ljung-Box")$p.value, error = function(e) NA_real_)
    )
  }) |> arrange(AICc)
  list(best = slice(res, 1), table = res, note = NA_character_)
}

# Horizon jusqu’à une cible (ex: "2026-Q4")
h_to <- function(last_qtr, target_qtr_chr){
  target <- zoo::as.yearqtr(target_qtr_chr, format = "%Y-Q%q")
  h <- as.integer(round((as.numeric(target) - as.numeric(last_qtr)) * 4))
  ifelse(h < 1, 1L, h)
}

# Forecast pour un pays avec ARMA(p,q)
forecast_country_arma <- function(data, country, p, q, h){
  x <- data |> filter(Country == country) |> pull(gdp_growth_seas) |> stats::na.omit()
  if (length(x) < 12 || is.na(p) || is.na(q)) return(NULL)
  tsx <- ts(x, frequency = 4)
  fit <- tryCatch(Arima(tsx, order = c(p,0,q), include.mean = TRUE), error = function(e) NULL)
  if (is.null(fit)) return(NULL)
  fc  <- forecast(fit, h = h)
  tibble(
    Country = country,
    horizon = seq_len(h),
    mean    = as.numeric(fc$mean),
    lower80 = as.numeric(fc$lower[, "80%"]),
    upper80 = as.numeric(fc$upper[, "80%"]),
    lower95 = as.numeric(fc$lower[, "95%"]),
    upper95 = as.numeric(fc$upper[, "95%"])
  )
}

# Plot prévision + historique (désais.)
plot_fc_country <- function(ctry, fc_tbl, df_seas, arma_choices, target_qtr){
  hist <- df_seas |> filter(Country == ctry, !is.na(gdp_growth_seas)) |>
    transmute(date = as.Date(Quarter), value = gdp_growth_seas)
  fc_c <- fc_tbl |> filter(Country == ctry)
  if (nrow(fc_c) == 0 || nrow(hist) == 0) return(NULL)
  
  last_date <- max(hist$date)
  steps     <- nrow(fc_c)
  future_dates <- seq(from = zoo::as.Date(zoo::as.yearqtr(last_date) + 1/4),
                      by = "quarter", length.out = steps)
  
  pd <- tibble(date = future_dates,
               mean = fc_c$mean,
               lower80 = fc_c$lower80, upper80 = fc_c$upper80,
               lower95 = fc_c$lower95, upper95 = fc_c$upper95)
  
  p <- ggplot() +
    geom_line(data = hist, aes(x = date, y = value), linewidth = 0.9, color = "grey30") +
    geom_ribbon(data = pd, aes(x = date, ymin = lower95, ymax = upper95), alpha = 0.15) +
    geom_ribbon(data = pd, aes(x = date, ymin = lower80, ymax = upper80), alpha = 0.25) +
    geom_line(data = pd, aes(x = date, y = mean), linewidth = 1) +
    geom_hline(yintercept = 0, linetype = "dashed", color = "grey40") +
    labs(
      title = paste0(ctry, " — ARMA forecast to ", target_qtr, " (seasonally adjusted)"),
      subtitle = {
        pq <- arma_choices |> filter(Country == ctry)
        paste0("Model: ARMA(", pq$p, ",", pq$q, "); horizon = ", steps, " quarters")
      },
      x = NULL, y = "% q/q"
    ) +
    theme_minimal(base_size = 13)
  ggsave(file.path("outputs", paste0("fc_", gsub(" ","_", tolower(ctry)), "_arma_seas_to_", gsub("-","",target_qtr), ".png")),
         p, width = 9, height = 5, dpi = 300)
  p
}

