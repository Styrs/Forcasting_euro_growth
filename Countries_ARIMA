# =========================================================
# 3) Test ADF par pays (sans reframe, warning étouffé)
# =========================================================
safe_adf <- function(x){
  x <- stats::na.omit(as.numeric(x))
  if (length(x) < 12) {
    return(tibble(n = length(x), adf_stat = NA_real_, p_value = NA_real_, note = "too short"))
  }
  test <- withCallingHandlers(
    tseries::adf.test(x, k = floor(length(x)^(1/3))),
    warning = function(w){
      if (grepl("p-value smaller than printed p-value", conditionMessage(w))) invokeRestart("muffleWarning")
    }
  )
  tibble(n = length(x), adf_stat = unname(test$statistic), p_value = test$p.value, note = NA_character_)
}

adf_results <- df %>%
  group_by(Country) %>%
  arrange(Quarter, .by_group = TRUE) %>%
  summarise(res = list(safe_adf(gdp_growth)), .groups = "drop") %>%
  unnest(res)

print(adf_results, n = Inf)

# =========================================================
# 4) Désaisonnalisation STL alignée (pas de décalage)
#    - On ne "na.omit" PAS la série entière: on ajuste sur la sous-série non-NA
#    - Puis on réinsère les NA aux mêmes positions
# =========================================================
stl_adjust <- function(x, freq = 4){
  # x: vecteur numeric avec NA possibles
  ix <- !is.na(x)
  out <- rep(NA_real_, length(x))
  if (sum(ix) >= 12) {
    ts_x <- ts(x[ix], frequency = freq)
    fit  <- stl(ts_x, s.window = "periodic")
    out[ix] <- as.numeric(seasadj(fit))
  }
  out
}

df_seas <- df %>%
