last_sig_lag <- function(acf_obj, n){
  if (is.null(acf_obj) || is.null(acf_obj$acf)) return(0)
  thr <- 1.96 / sqrt(n)
  vals <- acf_obj$acf[-1]
  sig  <- which(abs(vals) > thr)
  if (length(sig) == 0) 0 else max(sig)
}

suggest_pq_vec <- function(x, lag.max = 12){
  x <- stats::na.omit(as.numeric(x))
  if (length(x) < 12) return(tibble(p_suggest = 0L, q_suggest = 0L, note = "short series"))
  tsx <- ts(x, frequency = 4)
  a  <- tryCatch(acf(tsx,  plot = FALSE, lag.max = lag.max),  error = function(e) NULL)
  pa <- tryCatch(pacf(tsx, plot = FALSE, lag.max = lag.max), error = function(e) NULL)
  n  <- length(tsx)
  tibble(
    p_suggest = as.integer(last_sig_lag(pa, n)),  # PACF -> AR(p)
    q_suggest = as.integer(last_sig_lag(a,  n))   # ACF  -> MA(q)
  )
}

suggest_pq_by_country <- function(data, countries, value_col = "gdp_growth_seas", lag.max = 12){
  stopifnot(all(c("Country", value_col) %in% names(data)))
  data %>%
    filter(Country %in% countries) %>%
    group_by(Country) %>%
    summarise(suggest = list(suggest_pq_vec(.data[[value_col]], lag.max = lag.max)), .groups = "drop") %>%
    unnest(suggest) %>%
    arrange(Country)
}

plot_acf_pacf <- function(data, country, value_col = "gdp_growth_seas", lag.max = 12){
  x <- data %>% filter(Country == country) %>% pull(all_of(value_col)) %>% stats::na.omit()
  if (length(x) < 12) { message(country, ": série trop courte pour ACF/PACF."); return(invisible(NULL)) }
  tsx <- ts(x, frequency = 4)
  p <- forecast::ggtsdisplay(tsx, plot_type = "partial", lag.max = lag.max) +
    ggtitle(paste(country, "—", value_col, "(ACF / PACF)"))
  print(p)
  ggsave(file.path("outputs", paste0("acf_pacf_", gsub(" ", "_", tolower(country)), "_", value_col, ".png")),
         p, width = 8, height = 5, dpi = 300)
}

