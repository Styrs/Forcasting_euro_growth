library(dplyr)
library(tidyr)
library(zoo)
library(readxl)
library(writexl)  # Ajouter ce package pour write_xlsx

##---------------------------------------------------------------------
## We import and prepare the data
##---------------------------------------------------------------------

# Vérification du dataset initial
print("Objets dans votre environnement :")
ls()

print("Structure du dataset initial :")
str(namq_10_gdp_page_linear)

##---------------------------------------------------------------------
## Organizing the data, cleaning columns
##---------------------------------------------------------------------

# Supprimer les colonnes spécifiées
colonnes_a_supprimer <- c("DATAFLOW", "LAST UPDATE", "freq", "unit", "s_adj", "na_item", "OBS_FLAG", "CONF_STATUS")

data_simplifie <- namq_10_gdp_page_linear %>%
  select(-any_of(colonnes_a_supprimer))

print("Colonnes restantes après nettoyage :")
names(data_simplifie)

##---------------------------------------------------------------------
## Creating aggregated "other countries" series
##---------------------------------------------------------------------

data_avec_other <- data_simplifie %>%
  # Filtrer pour exclure les "other countries" existants
  filter(geo != "other countries") %>%
  # Grouper par TIME_PERIOD
  group_by(TIME_PERIOD) %>%
  # Créer une nouvelle ligne pour "other countries" avec la somme des OBS_VALUE
  group_modify(~ {
    somme_trimestre <- sum(.x$OBS_VALUE, na.rm = TRUE)
    modele_ligne <- .x[1, ]
    nouvelle_ligne <- modele_ligne
    nouvelle_ligne$geo <- "other countries"
    nouvelle_ligne$OBS_VALUE <- somme_trimestre
    bind_rows(.x, nouvelle_ligne)
  }) %>%
  ungroup() %>%
  arrange(TIME_PERIOD, geo)

print("Vérification de l'agrégation pour 2000-Q1 :")
data_avec_other %>%
  filter(TIME_PERIOD == "2000-Q1") %>%
  select(TIME_PERIOD, geo, OBS_VALUE)

##---------------------------------------------------------------------
## Creating EA15_other_countries dataset
##---------------------------------------------------------------------

EA15_other_countries <- data_avec_other %>%
  filter(geo == "other countries") %>%
  # Convertir TIME_PERIOD en format yearqtr comme dans votre exemple
  mutate(Quarter = as.yearqtr(TIME_PERIOD, format = "%Y-Q%q")) %>%
  arrange(Quarter)

print("Structure du dataset EA15_other_countries :")
str(EA15_other_countries)

print("Périodes disponibles :")
unique(EA15_other_countries$Quarter)

##---------------------------------------------------------------------
## Computing the log-diff to have the GDP growth (like your example)
##---------------------------------------------------------------------

EA15_other_countries_growth <- EA15_other_countries %>%
  arrange(Quarter) %>%
  # Safely take logs and compute growth (like your code)
  mutate(
    # Conversion sécurisée en log
    log_gdp = ifelse(OBS_VALUE > 0, log(OBS_VALUE), NA_real_),
    # Quarter-over-Quarter log growth (≈ % change): 100 * Δlog
    gdp_growth_qoq_log = 100 * (log_gdp - lag(log_gdp)),
    # Pour 2000-Q1 = 0 comme spécifié
    gdp_growth_qoq_log = ifelse(Quarter == as.yearqtr("2000 Q1"), 0, gdp_growth_qoq_log)
  ) %>%
  # Renommer pour cohérence
  rename(
    Country = geo,
    Nominal_GDP = OBS_VALUE,
    TIME_PERIOD_original = TIME_PERIOD
  ) %>%
  select(Country, Quarter, Nominal_GDP, gdp_growth_qoq_log, everything())

# Vérification finale
print("Aperçu du dataset final :")
head(EA15_other_countries_growth)

print("Vérification des premières valeurs de croissance :")
EA15_other_countries_growth %>%
  select(Country, Quarter, Nominal_GDP, gdp_growth_qoq_log) %>%
  head(10)

print("Statistiques de la croissance GDP :")
summary(EA15_other_countries_growth$gdp_growth_qoq_log)

##---------------------------------------------------------------------
## Optional: Save the results
##---------------------------------------------------------------------

# Sauvegarder en Excel (avec write_xlsx du package writexl)
write_xlsx(EA15_other_countries_growth, "EA15_other_countries_growth.xlsx")

# Sauvegarder en CSV
write.csv(EA15_other_countries_growth, "EA15_other_countries_growth.csv", row.names = FALSE)

print("Traitement terminé avec succès!")
