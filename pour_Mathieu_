# Trouver l'index de la ligne "Sum Small euro countries" pour "real_growth_pure_contribution"
row_index <- which(countries_gowth_contributions$Country == "Sum Small euro countries" & 
                   countries_gowth_contributions$type == "real_growth_pure_contribution")

cat("Index de la ligne à modifier:", row_index, "\n")

if (length(row_index) == 1) {
  cat("Ligne trouvée:", countries_gowth_contributions$Country[row_index], 
      countries_gowth_contributions$type[row_index], "\n\n")
  
  # Toutes les années depuis 2001 (2000 a NA)
  annees <- paste0(2001:2027)
  
  # Extraire les données nécessaires
  real_data <- subset(countries_gowth_contributions, 
                      type == "real_growth_pure_contribution")
  
  # Créer un vecteur avec les pays à sommer
  pays_grands <- c("France", "Germany", "Italy", "Netherlands", "Spain")
  
  cat("Calcul des nouvelles valeurs pour 'Sum Small euro countries':\n")
  cat("============================================================\n")
  
  # Pour chaque année, calculer la nouvelle valeur
  for (annee in annees) {
    # Valeur Eurozone (convertir en numérique)
    eurozone_val <- as.numeric(real_data[real_data$Country == "Eurozone", annee])
    
    # Somme des 5 grands pays
    somme_grands_pays <- 0
    for (pays in pays_grands) {
      valeur_pays <- as.numeric(real_data[real_data$Country == pays, annee])
      somme_grands_pays <- somme_grands_pays + valeur_pays
    }
    
    # Calculer: Eurozone - somme des 5 grands pays
    nouvelle_valeur <- eurozone_val - somme_grands_pays
    
    # Mettre à jour la valeur dans le dataset original
    countries_gowth_contributions[row_index, annee] <- nouvelle_valeur
    
    # Afficher le calcul (uniquement quelques années pour ne pas surcharger)
    if (annee %in% c("2001", "2005", "2010", "2015", "2020", "2025", "2027")) {
      cat(sprintf("%s: %.4f = %.4f - (", annee, nouvelle_valeur, eurozone_val))
      
      # Afficher les valeurs individuelles
      valeurs_pays <- sapply(pays_grands, function(p) {
        as.numeric(real_data[real_data$Country == p, annee])
      })
      cat(paste(sprintf("%.4f", valeurs_pays), collapse = " + "), ")\n")
    }
  }
  
  # Afficher un résumé des modifications
  cat("\n=== RÉSUMÉ DES MODIFICATIONS ===\n")
  cat("Valeurs mises à jour pour 'Sum Small euro countries' (real_growth_pure_contribution):\n")
  
  # Afficher quelques années clés
  annees_affichage <- c("2001", "2005", "2010", "2015", "2020", "2021", "2022", "2023", "2024", "2025", "2026", "2027")
  print(countries_gowth_contributions[row_index, c("Country", "type", annees_affichage)])
  
} else {
  cat("Erreur: Ligne non trouvée\n")
}
