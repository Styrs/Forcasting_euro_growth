

## ======================================================================
## 1. Import the data
## ======================================================================


url_euro_growth_gdp_seas <- "https://github.com/Styrs/Forcasting_euro_growth/raw/refs/heads/main/data_countries_euro_growth_gdp_seas.xlsx"

download.file(url_euro_growth_gdp_seas, destfile = "data.xlsx", mode = "wb")

data_countries_euro_growth_gdp_seas <- read_excel("data.xlsx")


# keep only non-missing growth, and ensure time order within each country
#Normally the data should be clear before that but we never know, security check 
data_clean <- data_countries_euro_growth_gdp_seas %>%
  filter(!is.na(gdp_growth_qoq_log)) %>%
  arrange(Country, Quarter)

##---------------------------------------------------------------------
# France
##---------------------------------------------------------------------

forecast_france_2010 <- function(data) {
  france_data <- data[data$Country == "France", ]
  train_data <- france_data[france_data$Quarter >= 2000.00 & france_data$Quarter <= 2009.75, ]
  ts_data <- ts(train_data$seasonal_adjusted, start = c(2000, 1), frequency = 4)
  
  return(list(
    train_data = train_data,
    ts_data = ts_data,
    forecast_date = "2010-Q1"
  ))
}

# ----------------------------------------------------------
### Test AIC -- dans la fonction
# ------------------------------------------------------------

# 1. Préparer les données avec la fonction corrigée
result <- forecast_france_2010(data_clean)

# 2. Test AIC avec auto.arima
library(forecast)
fit <- auto.arima(result$ts_data,
                  seasonal = FALSE,
                  ic = "aic",
                  stepwise = FALSE,
                  approximation = FALSE)

# 3. Résultats
best_order <- arimaorder(fit)
best_aic <- AIC(fit)

print(paste("Meilleur ARMA : (", best_order["p"], ",", best_order["q"], ")", sep = ""))
print(paste("AIC :", best_aic)) 

#----------------------------------------------------------------------
## Using AR5
#----------------------------------------------------------------------
# 1. Estimer le modèle AR(5)
model_ar5 <- Arima(result$ts_data, order = c(5, 0, 0))

# 2. Faire le forecast pour 2010-Q1
forecast_ar5 <- forecast(model_ar5, h = 1)

# 3. Afficher les résultats
print(paste("Forecast 2010-Q1 :", round(forecast_ar5$mean, 4)))
print(forecast_ar5)

# 4. Optionnel : Visualiser
plot(forecast_ar5, main = "Forecast AR(5) - France 2010-Q1")

#-------------------------------------------------------------------------
## compare result to the "real" value of 2010-Q1
#-------------------------------------------------------------------------

# 1. Récupérer la vraie valeur pour 2010-Q1
true_value <- data_clean$seasonal_adjusted[data_clean$Country == "France" & data_clean$Quarter == 2010.00]

# 2. Calculer l'erreur de prévision
forecast_error <- as.numeric(forecast_ar5$mean) - true_value

# 3. Afficher la comparaison
print(paste("Forecast 2010-Q1 :", round(forecast_ar5$mean, 4)))
print(paste("Vraie valeur 2010-Q1 :", round(true_value, 4)))
print(paste("Erreur de prévision :", round(forecast_error, 4)))
print(paste("Erreur relative :", round(forecast_error/true_value * 100, 2), "%"))

# 4. Résumé complet
results <- data.frame(
  Date = "2010-Q1",
  Forecast = as.numeric(forecast_ar5$mean),
  Actual = true_value,
  Error = forecast_error,
  ARMA_Order = "AR(5)",
  AIC = AIC(model_ar5)
)

print(results)

